config {
  type: "table",
  schema: "reference",
  description: "US federal public holidays from 2013 to 2025. Used as a reference dimension for holiday impact analysis. Maintained as a standalone seed table for easy updates.",
  columns: {
    holiday_date: "Date of the public holiday",
    holiday_name: "Official name of the holiday",
    holiday_year: "Year extracted from holiday_date for filtering"
  }
}

SELECT holiday_date, holiday_name, EXTRACT(YEAR FROM holiday_date) AS holiday_year
FROM UNNEST([
  -- 2013
  STRUCT(DATE '2013-01-01' AS holiday_date, 'New Year''s Day' AS holiday_name),
  STRUCT(DATE '2013-01-21', 'Martin Luther King Jr. Day'),
  STRUCT(DATE '2013-02-18', 'Presidents'' Day'),
  STRUCT(DATE '2013-05-27', 'Memorial Day'),
  STRUCT(DATE '2013-07-04', 'Independence Day'),
  STRUCT(DATE '2013-09-02', 'Labor Day'),
  STRUCT(DATE '2013-11-28', 'Thanksgiving'),
  STRUCT(DATE '2013-12-25', 'Christmas Day'),
  -- 2014
  STRUCT(DATE '2014-01-01', 'New Year''s Day'),
  STRUCT(DATE '2014-01-20', 'Martin Luther King Jr. Day'),
  STRUCT(DATE '2014-02-17', 'Presidents'' Day'),
  STRUCT(DATE '2014-05-26', 'Memorial Day'),
  STRUCT(DATE '2014-07-04', 'Independence Day'),
  STRUCT(DATE '2014-09-01', 'Labor Day'),
  STRUCT(DATE '2014-11-27', 'Thanksgiving'),
  STRUCT(DATE '2014-12-25', 'Christmas Day'),
  -- 2015
  STRUCT(DATE '2015-01-01', 'New Year''s Day'),
  STRUCT(DATE '2015-01-19', 'Martin Luther King Jr. Day'),
  STRUCT(DATE '2015-02-16', 'Presidents'' Day'),
  STRUCT(DATE '2015-05-25', 'Memorial Day'),
  STRUCT(DATE '2015-07-04', 'Independence Day'),
  STRUCT(DATE '2015-09-07', 'Labor Day'),
  STRUCT(DATE '2015-11-26', 'Thanksgiving'),
  STRUCT(DATE '2015-12-25', 'Christmas Day'),
  -- 2016
  STRUCT(DATE '2016-01-01', 'New Year''s Day'),
  STRUCT(DATE '2016-01-18', 'Martin Luther King Jr. Day'),
  STRUCT(DATE '2016-02-15', 'Presidents'' Day'),
  STRUCT(DATE '2016-05-30', 'Memorial Day'),
  STRUCT(DATE '2016-07-04', 'Independence Day'),
  STRUCT(DATE '2016-09-05', 'Labor Day'),
  STRUCT(DATE '2016-11-24', 'Thanksgiving'),
  STRUCT(DATE '2016-12-25', 'Christmas Day'),
  -- 2017
  STRUCT(DATE '2017-01-01', 'New Year''s Day'),
  STRUCT(DATE '2017-01-16', 'Martin Luther King Jr. Day'),
  STRUCT(DATE '2017-02-20', 'Presidents'' Day'),
  STRUCT(DATE '2017-05-29', 'Memorial Day'),
  STRUCT(DATE '2017-07-04', 'Independence Day'),
  STRUCT(DATE '2017-09-04', 'Labor Day'),
  STRUCT(DATE '2017-11-23', 'Thanksgiving'),
  STRUCT(DATE '2017-12-25', 'Christmas Day'),
  -- 2018
  STRUCT(DATE '2018-01-01', 'New Year''s Day'),
  STRUCT(DATE '2018-01-15', 'Martin Luther King Jr. Day'),
  STRUCT(DATE '2018-02-19', 'Presidents'' Day'),
  STRUCT(DATE '2018-05-28', 'Memorial Day'),
  STRUCT(DATE '2018-07-04', 'Independence Day'),
  STRUCT(DATE '2018-09-03', 'Labor Day'),
  STRUCT(DATE '2018-11-22', 'Thanksgiving'),
  STRUCT(DATE '2018-12-25', 'Christmas Day'),
  -- 2019
  STRUCT(DATE '2019-01-01', 'New Year''s Day'),
  STRUCT(DATE '2019-01-21', 'Martin Luther King Jr. Day'),
  STRUCT(DATE '2019-02-18', 'Presidents'' Day'),
  STRUCT(DATE '2019-05-27', 'Memorial Day'),
  STRUCT(DATE '2019-07-04', 'Independence Day'),
  STRUCT(DATE '2019-09-02', 'Labor Day'),
  STRUCT(DATE '2019-11-28', 'Thanksgiving'),
  STRUCT(DATE '2019-12-25', 'Christmas Day'),
  -- 2020
  STRUCT(DATE '2020-01-01', 'New Year''s Day'),
  STRUCT(DATE '2020-01-20', 'Martin Luther King Jr. Day'),
  STRUCT(DATE '2020-02-17', 'Presidents'' Day'),
  STRUCT(DATE '2020-05-25', 'Memorial Day'),
  STRUCT(DATE '2020-07-04', 'Independence Day'),
  STRUCT(DATE '2020-09-07', 'Labor Day'),
  STRUCT(DATE '2020-11-26', 'Thanksgiving'),
  STRUCT(DATE '2020-12-25', 'Christmas Day'),
  -- 2021
  STRUCT(DATE '2021-01-01', 'New Year''s Day'),
  STRUCT(DATE '2021-01-18', 'Martin Luther King Jr. Day'),
  STRUCT(DATE '2021-02-15', 'Presidents'' Day'),
  STRUCT(DATE '2021-05-31', 'Memorial Day'),
  STRUCT(DATE '2021-07-04', 'Independence Day'),
  STRUCT(DATE '2021-09-06', 'Labor Day'),
  STRUCT(DATE '2021-11-25', 'Thanksgiving'),
  STRUCT(DATE '2021-12-25', 'Christmas Day'),
  -- 2022
  STRUCT(DATE '2022-01-01', 'New Year''s Day'),
  STRUCT(DATE '2022-01-17', 'Martin Luther King Jr. Day'),
  STRUCT(DATE '2022-02-21', 'Presidents'' Day'),
  STRUCT(DATE '2022-05-30', 'Memorial Day'),
  STRUCT(DATE '2022-07-04', 'Independence Day'),
  STRUCT(DATE '2022-09-05', 'Labor Day'),
  STRUCT(DATE '2022-11-24', 'Thanksgiving'),
  STRUCT(DATE '2022-12-25', 'Christmas Day'),
  -- 2023
  STRUCT(DATE '2023-01-01', 'New Year''s Day'),
  STRUCT(DATE '2023-01-16', 'Martin Luther King Jr. Day'),
  STRUCT(DATE '2023-02-20', 'Presidents'' Day'),
  STRUCT(DATE '2023-05-29', 'Memorial Day'),
  STRUCT(DATE '2023-07-04', 'Independence Day'),
  STRUCT(DATE '2023-09-04', 'Labor Day'),
  STRUCT(DATE '2023-11-23', 'Thanksgiving'),
  STRUCT(DATE '2023-12-25', 'Christmas Day'),
  -- 2024
  STRUCT(DATE '2024-01-01', 'New Year''s Day'),
  STRUCT(DATE '2024-01-15', 'Martin Luther King Jr. Day'),
  STRUCT(DATE '2024-02-19', 'Presidents'' Day'),
  STRUCT(DATE '2024-05-27', 'Memorial Day'),
  STRUCT(DATE '2024-07-04', 'Independence Day'),
  STRUCT(DATE '2024-09-02', 'Labor Day'),
  STRUCT(DATE '2024-11-28', 'Thanksgiving'),
  STRUCT(DATE '2024-12-25', 'Christmas Day'),
  -- 2025
  STRUCT(DATE '2025-01-01', 'New Year''s Day'),
  STRUCT(DATE '2025-01-20', 'Martin Luther King Jr. Day'),
  STRUCT(DATE '2025-02-17', 'Presidents'' Day'),
  STRUCT(DATE '2025-05-26', 'Memorial Day'),
  STRUCT(DATE '2025-07-04', 'Independence Day'),
  STRUCT(DATE '2025-09-01', 'Labor Day'),
  STRUCT(DATE '2025-11-27', 'Thanksgiving'),
  STRUCT(DATE '2025-12-25', 'Christmas Day')
])